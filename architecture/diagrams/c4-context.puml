@startuml c4-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Trading Card Game - System Context

Person(player, "Player", "Plays a match against another player or against a computer opponent")
System(tcg, "Trading Card Game", "Runs matches (player vs player or player vs computer): health, mana, deck, hand, turns, damage and win conditions")
System_Ext(idp, "Identity Provider", "Authenticates players")

Rel(player, tcg, "Plays matches using", "HTTPS")
Rel(tcg, idp, "Authenticates players via", "OAuth2/JWT")

@enduml
